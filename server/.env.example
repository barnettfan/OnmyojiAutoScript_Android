# Public DNS name only: do not add https://, a path, or a port.
OAS_PUBLIC_HOST=oas.example.com

# Email used by Let's Encrypt/Caddy for certificate notifications.
OAS_CADDY_EMAIL=admin@example.com

# Generate distinct values, for example: openssl rand -base64 36
# This one is shared by the Server and every Android/redroid Agent.
OAS_AGENT_SHARED_SECRET=replace-with-a-long-random-agent-secret

# The protected management UI/API always uses the Basic Auth username "admin".
OAS_AGENT_ADMIN_PASSWORD=replace-with-a-different-long-random-admin-password
