{
    # Caddy automatically obtains and renews the certificate for the configured
    # public hostname. Both the Agent WSS and error-bundle HTTPS requests use it.
    email {$OAS_CADDY_EMAIL}
}

{$OAS_PUBLIC_HOST} {
    encode zstd gzip

    # Caddy forwards WebSocket upgrades by default, which keeps /agent/ws as
    # one long-lived WSS connection without exposing the Uvicorn port publicly.
    reverse_proxy oas-control-plane:22270
}
